# HTTPS in front of SelfKept. Used by: docker compose --profile https up -d
#
# SELFKEPT_HOST is the name you type in the browser (set it in .env).
#  - A real domain pointing at this machine, with ports 80 and 443 reachable from the internet:
#    Caddy gets a free public certificate by itself.
#  - A home name such as selfkept.home.arpa or selfkept.local: Caddy signs the certificate with
#    its own private authority. Each device must trust that authority once (phones make this
#    awkward), or the browser shows a warning. Tailscale (docs/self-host.md) avoids that.
{$SELFKEPT_HOST} {
	# The app sets its own security headers.
	reverse_proxy app:8080 {
		# Server-sent events must not be buffered.
		flush_interval -1
	}
}

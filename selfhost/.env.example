# Copy to .env (next to compose.yaml). Every line is optional: the defaults give you
# http://127.0.0.1:8080 on the machine itself, ready for Tailscale Serve.
#
# Any SELFKEPT_* line here is read by compose.yaml and handed to the app as a .NET setting.
# To set a setting that has no SELFKEPT_ line, add it under the app service's environment:
# in compose.yaml. A double underscore stands for a colon (App__BaseUrl sets App:BaseUrl).

# Which release to run. "latest" follows the newest; pin a number (for example 0.1.0) to upgrade on purpose.
# SELFKEPT_VERSION=latest

# The address people type into the browser and into the phone app. Use https:// and your
# Tailscale name once Tailscale Serve is in front (docs/self-host.md).
# SELFKEPT_ORIGIN=https://your-machine.your-tailnet.ts.net

# Port, and which network interface to listen on. 127.0.0.1 (the default) keeps the app off
# your LAN so that Tailscale or Caddy on this machine is the only way in. 0.0.0.0 opens it
# to the LAN over plain HTTP.
# SELFKEPT_PORT=8080
# SELFKEPT_BIND=127.0.0.1

# Only for the Caddy profile (docker compose --profile https up -d): the host name Caddy
# answers for and gets a certificate for.
# SELFKEPT_HOST=selfkept.example.com

# Only if Docker reports "Pool overlaps" for the bundled 172.30.0.0/24 network.
# SELFKEPT_WEB_SUBNET=172.31.0.0/24
# SELFKEPT_WEB_GATEWAY=172.31.0.1
# SELFKEPT_CADDY_IP=172.31.0.250

# Insight sentences from a local model (optional). Ollama on this machine, from inside Docker:
# SELFKEPT_AI_ENABLED=true
# SELFKEPT_AI_BASE_URL=http://host.docker.internal:11434/v1
# SELFKEPT_AI_MODEL=qwen3:8b
# A thinking model (qwen3, qwen3.5, gemma) needs this, or its thinking uses up the reply:
# SELFKEPT_AI_REASONING_EFFORT=none
# Only for a gateway that queues by priority; sent with calls a person is waiting on:
# SELFKEPT_AI_INTERACTIVE_HEADER=X-GPU-Priority: interactive
# Seconds of silence allowed before the template takes over (a cold model needs a few):
# SELFKEPT_AI_TIMEOUT_SECONDS=20

# Cloud lookup (optional, off by default). Lets each person who turns it on for themselves send
# one question, whose exact text they read and confirm, to Anthropic's API with web search, and
# keep the answer with its sources. Nothing else leaves the server, and nothing is sent unless
# the person presses send. The key is your own, created in the Anthropic console, and the usage
# is billed to your Anthropic account. It can also be a file named Lookup__ApiKey in the secrets volume.
# SELFKEPT_LOOKUP_ENABLED=true
# SELFKEPT_LOOKUP_API_KEY=
# SELFKEPT_LOOKUP_MODEL=claude-opus-5-5

# Oura (optional): create an API application at https://cloud.ouraring.com/oauth/applications
# with the redirect URI <SELFKEPT_ORIGIN>/api/oura/callback, then:
# SELFKEPT_OURA_CLIENT_ID=
# SELFKEPT_OURA_CLIENT_SECRET=

# Single sign-on (optional) through your own OpenID Connect provider. Register this server there
# as a confidential client with the callback <SELFKEPT_ORIGIN>/api/auth/sso/callback, then:
# SELFKEPT_SSO_AUTHORITY=https://id.your-tailnet.ts.net
# SELFKEPT_SSO_CLIENT_ID=
# SELFKEPT_SSO_CLIENT_SECRET=
# SELFKEPT_SSO_NAME=Pocket ID
# Only if this server cannot reach the provider at its public address (the provider runs on the
# same machine, say): where the server itself reaches it, such as a Docker network name.
# SELFKEPT_SSO_INTERNAL_URL=http://pocket-id:1411

# How many months of raw heart rate to keep (optional). Older months are folded into one row a
# minute (mean, min, max, count); daily values, sleep, HRV and everything else stay as they are.
# Unset lets the admin choose in the app, 12 by default. 0 keeps raw for ever; otherwise 4 to 600.
# SELFKEPT_RETENTION_MONTHS=12
